// Match Insights persistence (Phase 0 foundation).
// Target: Supabase Postgres. Provide DATABASE_URL (pooled, pgbouncer) and
// DIRECT_URL (direct 5432, used for migrations) — see .env.example.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Single | 20-game trend analysis.
enum AnalysisType {
  single
  trend
}

/// Immutable raw Match-V5 match payload, cached once per matchId.
model MatchRaw {
  matchId   String   @id @map("match_id")
  region    String
  patch     String
  fetchedAt DateTime @default(now()) @map("fetched_at")
  rawJson   Json     @map("raw_json")

  @@map("matches_raw")
}

/// Immutable raw Match-V5 timeline payload (largest payload; fetched on demand).
model TimelineRaw {
  matchId   String   @id @map("match_id")
  fetchedAt DateTime @default(now()) @map("fetched_at")
  rawJson   Json     @map("raw_json")

  @@map("timelines_raw")
}

/// Extracted per-participant metrics for one match. Dimension columns are typed;
/// the numeric metric set (defined by the Phase 1 stats engine, 02-stats-engine.md)
/// lives in `metrics` JSONB so new metrics don't require a migration each time.
model ParticipantFacts {
  matchId    String   @map("match_id")
  puuid      String
  role       String
  championId Int      @map("champion_id")
  patch      String
  rankTier   String   @map("rank_tier")
  metrics    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([matchId, puuid])
  @@index([patch, rankTier, role])
  @@map("participant_facts")
}

/// Permanent cache of LLM analyses. A finished match never changes, so keyed by
/// (puuid, matchId, type, promptVersion). Token/cost columns track spend per row.
model Analysis {
  id            String       @id @default(cuid())
  puuid         String
  matchId       String?      @map("match_id")
  type          AnalysisType
  promptVersion String       @map("prompt_version")
  modelUsed     String       @map("model_used")
  inputFacts    Json         @map("input_facts")
  outputJson    Json         @map("output_json")
  tokensIn      Int          @map("tokens_in")
  tokensOut     Int          @map("tokens_out")
  costUsd       Decimal      @map("cost_usd") @db.Decimal(10, 6)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@unique([puuid, matchId, type, promptVersion], name: "analysis_cache_key")
  @@index([createdAt])
  @@map("analyses")
}

/// Percentile benchmarks per (patch, rankTier, role, metric) for scoring.
model Benchmark {
  patch      String
  rankTier   String @map("rank_tier")
  role       String
  metricName String @map("metric_name")
  p25        Float
  p50        Float
  p75        Float
  p90        Float
  sampleN    Int    @map("sample_n")

  @@id([patch, rankTier, role, metricName])
  @@map("benchmarks")
}

/// Riot IDs observed in match payloads we fetched ourselves (Account-V1 has no
/// name→tags lookup, so this self-built index powers tag autocomplete).
/// One row per puuid; the newest observation wins when a name changes.
model RiotIdIndex {
  puuid              String   @id
  region             String
  gameName           String   @map("game_name")
  gameNameNormalized String   @map("game_name_normalized")
  tagLine            String   @map("tag_line")
  seenCount          Int      @default(1) @map("seen_count")
  lastSeenAt         DateTime @map("last_seen_at")

  @@index([region, gameNameNormalized])
  @@map("riot_id_index")
}

/// Lifecycle of a lazy benchmark cohort fill (spec: benchmark-data-acquisition).
enum BenchmarkJobStatus {
  pending
  running
  done
  failed
}

/// Resumable crawl job that fills one (patch, rankTier) benchmark cohort.
/// Enqueued on a benchmark cache miss; processed in ~50-request chunks by the
/// cron route. The unique key makes concurrent visitors collide into ONE job.
model BenchmarkJob {
  id              String             @id @default(cuid())
  patch           String
  rankTier        String             @map("rank_tier")
  /// Platform region to crawl (e.g. euw1) — from the match that triggered the miss.
  region          String
  status          BenchmarkJobStatus @default(pending)
  /// Ladder players sampled as crawl seeds. Empty until the seeding step runs.
  seedPuuids      Json               @default("[]") @map("seed_puuids")
  /// Dedup'd match ids still to fetch (the resumable cursor).
  pendingMatchIds Json               @default("[]") @map("pending_match_ids")
  processedCount  Int                @default(0) @map("processed_count")
  attempts        Int                @default(0)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@unique([patch, rankTier], name: "job_cohort_key")
  @@index([status, createdAt])
  @@map("benchmark_jobs")
}
