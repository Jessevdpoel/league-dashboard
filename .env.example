# --- Riot API ---
# Personal/dev key from https://developer.riotgames.com (20 req/s, 100 req/2min).
RIOT_API_KEY=

# --- Database (Supabase Postgres) ---
# DATABASE_URL: pooled connection (Transaction pooler, port 6543) used at runtime.
#   Append ?pgbouncer=true so Prisma disables prepared statements.
# DIRECT_URL:   direct connection (port 5432) used by Prisma Migrate.
# Get both from Supabase -> Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Anthropic (Phase 1 AI analysis; not required for Phase 0) ---
# ANTHROPIC_API_KEY=
